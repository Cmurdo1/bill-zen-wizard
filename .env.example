# ── Supabase (required) ────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-side values (used in API routes / SSR — keep out of the client bundle).
# Set these in your host's environment, not in the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project id (optional, used by tooling)
SUPABASE_PROJECT_ID=

# ── Google OAuth (Supabase Auth) ───────────────────────────────────────
# Optional — used when configuring the Google provider in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ──────────────────────────────────────────────────────────────
# Sending invoices/estimates to clients.
RESEND_API_KEY=
RESEND_FROM=Honest Invoice <invoices@honestinvoice.com>
# Auth emails (signup confirmation, password reset, magic link) are sent by
# Supabase itself — configure SMTP in the Supabase dashboard
# (e.g. Resend: host smtp.resend.com, port 465, user resend, password = API key).

# ── Stripe ─────────────────────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=
# Optional: server-side session lookups
STRIPE_SECRET_KEY=
# Checkout links for the pricing page
VITE_STRIPE_PAYMENT_LINK_PRO=
VITE_STRIPE_PAYMENT_LINK_BUSINESS=

# ── AI line-item extraction ────────────────────────────────────────────
# Primary provider: OpenRouter (default model "openrouter/free" — the free
# router that cycles through available free models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=           # optional override
# Backup provider: NVIDIA NIM.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=               # optional override

# ── MCP / AI agent access ──────────────────────────────────────────────
# Dedicated API key created in Settings → API keys (for the MCP server).
HONEST_INVOICE_API_KEY=
# Deployed app URL (used for lead tracking pixels and emails).
APP_BASE_URL=https://honestinvoice.com
APP_URL=https://honestinvoice.com
